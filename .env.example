# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Claude (extraction + parse)
ANTHROPIC_API_KEY=
# Optional model override for the live parse/extract calls (default: claude-sonnet-5)
VERDICT_MODEL=

# NCBI E-utilities etiquette (required by NCBI usage policy)
NCBI_EMAIL=
NCBI_TOOL=verdict

# Optional NCBI API key for higher rate limits
NCBI_API_KEY=
